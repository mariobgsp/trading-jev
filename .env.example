# Copy to .env and fill in. .env is gitignored and never committed.
# Nothing provider-specific belongs in a tracked file — the endpoint and the model id are
# configuration, so they live here with the key. Each backend carries its own key: a key from
# one account tier is rejected by the other, so one shared variable would only ever 403.
JEV_BACKEND=chat           # structured | chat
JEV_API_KEY=
JEV_API_URL=               # structured: the decision endpoint
JEV_MODEL=                 # structured: its model id
JEV_CHAT_KEY=
JEV_CHAT_URL=              # chat: a chat-completions endpoint
JEV_CHAT_MODEL=            # chat: a model that can be told to answer in JSON
