# Copy to .env and fill in. .env is gitignored and never committed.
# Nothing provider-specific belongs in a tracked file — the endpoint and the model id are
# configuration, so they live here with the key. Each backend carries its own key: a key from
# one account tier is rejected by the other, so one shared variable would only ever 403.
JEV_BACKEND=structured     # structured (a decision endpoint) | chat (a chat model, coerced)
# The structured backend is an HTTP decision endpoint, not a vendor: it posts {model, state,
# questions} and expects {answers}. Point it at the local Bekko service to decide on this machine
# with no per-candidate token cost, or at a hosted endpoint. https is required except on loopback.
JEV_API_KEY=
JEV_API_URL=http://127.0.0.1:8730/decide
JEV_MODEL=hotchpotch/bekko-system-one-v0-17m
# Local service: ~/Projects/bekko-local/bekko_serve.py, started with its own venv. It pins the
# model revision because trust_remote_code executes code from the model repository. The weights are
# licensed separately from the code (repo MIT, model repo has no LICENSE), which is why this is a
# config value that can point elsewhere rather than a hardcoded default.
# Alternative: decide with a chat model instead. Fill all three to use it; the key is not
# shared with the one above, because each account tier rejects the other's key.
JEV_CHAT_KEY=
JEV_CHAT_URL=              # a chat-completions endpoint
JEV_CHAT_MODEL=            # a model that can be told to answer in JSON
